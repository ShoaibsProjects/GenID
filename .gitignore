# ─── GenID ────────────────────────────────────────────────
# Environment — NEVER commit real secrets
.env
.env.local
.env.production
.env.*.local
**/.env

# Application vault store (AES-256-GCM encrypted, but never commit it)
**/vault.json
**/vault-data.json
**/secrets.*

# Dependencies
**/node_modules
**/vendor

# Build outputs
**/build
**/dist
**/.next
**/out

# Go
**/*.exe
**/*.exe~
**/*.dll
**/identity-service
**/*.so
**/*.dylib
**/*.test
**/*.out
**/go.work.sum
**/vendor
**/bin

# Generated
**/pkg/proto

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
**/.DS_Store
Thumbs.db

# Docker
**/.docker

# Cloudflare
wrangler.toml

