# ─── GenID local development environment ─────────────────────
# Copy this file to infrastructure/.env and fill in real values.
# NEVER commit .env — it is gitignored. Production values come from
# CI/CD secrets, not this file.

# ─── PostgreSQL ──────────────────────────────────────────────
POSTGRES_DB=observeid
POSTGRES_USER=observeid
POSTGRES_PASSWORD=change-me

# ─── Neo4j ──────────────────────────────────────────────────
NEO4J_PASSWORD=change-me

# ─── Grafana ────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# ─── Identity Service ───────────────────────────────────────
DATABASE_URL=postgresql://observeid:change-me@postgres:5432/observeid?sslmode=disable
NEO4J_USER=neo4j
REDIS_ADDR=redis:6379
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=critical-offboarding
NATS_URL=nats://nats:4222
JWKS_URL=http://localhost:8080/.well-known/jwks.json
API_KEYS=admin-key:change-me
MASTER_KEY=dev-only-master-key-32-bytes-long-x
JWT_SIGNING_KEY=dev-only-hs256-signing-key-replaced-by-rsa
DEV_LOGIN_ENABLED=true

# ─── SMTP / Notifications ───────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
ADMIN_EMAIL=your-email@gmail.com
DASHBOARD_URL=http://localhost:3001

# ─── Vault ──────────────────────────────────────────────────
VAULT_MASTER_KEY=production-vault-master-key-32-chars-minimum-length-required
VAULT_PATH=/data/genid-vault.json
VAULT_BACKEND=postgres